<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='discuss']" position="inside">
                <setting
                    id="online_signature"
                    help="Configure your contact mention suggestions in chatter messages"
                >
                    <field name="mail_mention_suggestion_option" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
