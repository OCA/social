<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_support" model="ir.module.category">
        <field name="name">Support Center</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_support_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_support" />
    </record>

    <record id="group_support_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_support" />
        <field name="implied_ids" eval="[(4, ref('group_support_user'))]" />
    </record>
</odoo>
