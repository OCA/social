<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Stage Tree View -->
    <record id="support_conversation_stage_view_tree" model="ir.ui.view">
        <field name="name">support.conversation.stage.tree</field>
        <field name="model">support.conversation.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="closed" />
                <field name="fold" />
            </list>
        </field>
    </record>

    <!-- Stage Form View -->
    <record id="support_conversation_stage_view_form" model="ir.ui.view">
        <field name="name">support.conversation.stage.form</field>
        <field name="model">support.conversation.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="closed" />
                            <field name="fold" />
                            <field name="mail_template_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stage Action -->
    <record id="action_support_conversation_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">support.conversation.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
