<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="support_team_view_tree" model="ir.ui.view">
        <field name="name">support.team.view.tree</field>
        <field name="model">support.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="leader_id" widget="many2one_avatar_user" />
                <field name="member_count" />
                <field name="conversation_count" />
                <field name="auto_assign" widget="boolean_toggle" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="support_team_view_form" model="ir.ui.view">
        <field name="name">support.team.view.form</field>
        <field name="model">support.team</field>
        <field name="arch" type="xml">
            <form string="Support Team">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Team name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Team Configuration">
                            <field
                                name="leader_id"
                                domain="[('id', 'in', member_ids)]"
                            />
                            <field name="color" widget="color_picker" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                        <group string="Statistics">
                            <field name="member_count" />
                            <field name="conversation_count" />
                        </group>
                    </group>
                    <group string="Assignment Settings">
                        <group>
                            <field name="auto_assign" />
                            <field
                                name="assignment_method"
                                invisible="not auto_assign"
                            />
                            <field
                                name="max_conversations_per_agent"
                                invisible="not auto_assign"
                            />
                        </group>
                        <group>
                            <field name="channel_types" />
                            <field
                                name="allowed_channel_ids"
                                invisible="channel_types != 'selected'"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field
                                name="member_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            >
                                <list>
                                    <field name="name" />
                                    <field name="email" />
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field
                                name="description"
                                placeholder="Team description and responsibilities..."
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="support_team_view_kanban" model="ir.ui.view">
        <field name="name">support.team.view.kanban</field>
        <field name="model">support.team</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="color" />
                <field name="member_count" />
                <field name="conversation_count" />
                <templates>
                    <t t-name="kanban-card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value}">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name" />
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Members</span>
                                    <strong>
                                        <field name="member_count" />
                                    </strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Open Conversations</span>
                                    <strong>
                                        <field name="conversation_count" />
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_card_footer">
                                <field name="leader_id" widget="many2one_avatar_user" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_support_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">support.team</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first support team
            </p>
            <p>
                Teams help organize agents and route conversations efficiently.
            </p>
        </field>
    </record>
</odoo>
