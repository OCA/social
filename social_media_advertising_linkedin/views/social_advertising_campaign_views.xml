<odoo>

    <record model="ir.ui.view" id="social_advertising_campaign_view_form_inherit">
        <field
            name="name"
        >social.advertising.campaign.view.form.inherit.advertising.linkedin</field>
        <field name="model">social.advertising.campaign</field>
        <field
            name="inherit_id"
            ref="social_media_advertising.social_advertising_campaign_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="media_type" invisible="1" />
                <field name="remote_ref" invisible="1" />
                <field name="linkedin_needs_update" invisible="1" />
                <field name="linkedin_locked" invisible="1" />
                <button
                    name="action_publish_linkedin"
                    type="object"
                    string="Create in LinkedIn"
                    class="btn-primary"
                    invisible="media_type != 'linkedin' or remote_ref or linkedin_locked"
                    confirm="The campaign group and the campaign will be created on LinkedIn in draft status. Continue?"
                />
                <button
                    name="action_update_linkedin"
                    type="object"
                    string="Update in LinkedIn"
                    class="btn-primary"
                    invisible="media_type != 'linkedin' or not remote_ref or not linkedin_needs_update or linkedin_locked"
                    confirm="Do you want to update the values on LinkedIn?"
                />
                <button
                    name="action_archive_linkedin"
                    type="object"
                    string="Archive in LinkedIn"
                    invisible="media_type != 'linkedin' or not remote_ref or linkedin_locked"
                    title="Stops the campaign on LinkedIn and takes it out of the Campaign Manager lists. LinkedIn does not allow deleting a campaign, archiving is the only way to end it, and it refuses to archive a campaign whose campaign group is still in draft status. The campaign is kept in Odoo with its performance data, and it can no longer be modified."
                    confirm="The campaign will be archived on LinkedIn and will stop running. It cannot be reactivated from Odoo. It stays in Odoo with its performance data. Continue?"
                />
            </xpath>
            <xpath expr="//header/field[@name='stage_id']" position="attributes">
                <attribute name="options">{}</attribute>
                <attribute name="readonly">media_type == 'linkedin'</attribute>
            </xpath>
            <xpath
                expr="//div[hasclass('oe_title')]//field[@name='name']"
                position="attributes"
            >
                <attribute name="readonly">linkedin_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='campaign_group_id']" position="attributes">
                <attribute name="readonly">linkedin_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='media_id']" position="attributes">
                <attribute name="readonly">remote_ref</attribute>
            </xpath>
            <xpath expr="//group[@name='social_media_general']" position="after">
                <group
                    name="social_media_linkedin"
                    string="LinkedIn"
                    invisible="media_type != 'linkedin'"
                >
                    <field
                        name="unit_cost"
                        required="media_type == 'linkedin'"
                        readonly="linkedin_locked"
                    />
                    <field
                        name="daily_budget"
                        required="media_type == 'linkedin'"
                        readonly="linkedin_locked"
                    />
                    <field name="currency_id" />
                    <field
                        name="linkedin_format"
                        required="media_type == 'linkedin'"
                        readonly="remote_ref"
                    />
                    <field
                        name="linkedin_objective"
                        required="linkedin_format == 'SINGLE_VIDEO'"
                        readonly="remote_ref"
                    />
                    <field
                        name="linkedin_political_intent"
                        required="media_type == 'linkedin'"
                        readonly="linkedin_locked"
                    />
                    <field name="linkedin_is_test" invisible="not remote_ref" />
                </group>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget
                    name="web_ribbon"
                    title="Pending changes"
                    tooltip="The local changes have not been pushed to LinkedIn yet"
                    bg_color="text-bg-warning"
                    invisible="media_type != 'linkedin' or not linkedin_needs_update"
                />
            </xpath>
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="media_type != 'linkedin' or not linkedin_needs_update or linkedin_locked"
                >
                    The campaign has local changes that are not synchronized
                    with LinkedIn. Use the <b>Update in LinkedIn</b> button to
                    push them.
                </div>
                <div
                    class="alert alert-danger"
                    role="alert"
                    invisible="media_type != 'linkedin' or not linkedin_locked"
                >
                    The LinkedIn status of this campaign does not allow
                    modifications.
                </div>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="social_advertising_campaign_view_tree_inherit">
        <field
            name="name"
        >social.advertising.campaign.view.tree.inherit.advertising.linkedin</field>
        <field name="model">social.advertising.campaign</field>
        <field
            name="inherit_id"
            ref="social_media_advertising.social_advertising_campaign_view_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">linkedin_needs_update</attribute>
            </xpath>
            <xpath expr="//field[@name='account_ids']" position="after">
                <field name="unit_cost" optional="show" />
                <field name="daily_budget" optional="show" />
                <field name="currency_id" optional="hide" />
                <field name="linkedin_needs_update" optional="show" />
            </xpath>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="social_advertising_campaign_linkedin_action"
    >
        <field name="name">Campaigns</field>
        <field name="res_model">social.advertising.campaign</field>
        <field name="view_mode">tree,form</field>
        <field
            name="search_view_id"
            ref="social_media_advertising.social_advertising_campaign_view_search"
        />
        <field name="domain">[('media_id.media_type', '=', 'linkedin')]</field>
        <field
            name="context"
            eval="{'default_media_id': ref('social_media_linkedin.social_media_linkedin')}"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first LinkedIn campaign
            </p>
            <p>
                Campaigns hold the budget and bidding settings used to promote
                your posts on LinkedIn.
            </p>
        </field>
    </record>

</odoo>
