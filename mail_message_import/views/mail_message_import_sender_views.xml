<odoo>
    <!-- Senders -->
    <record id="mail_message_import_sender_view_list" model="ir.ui.view">
        <field name="name">mail.message.import.sender.list</field>
        <field name="model">mail.message.import.sender</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="partner_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="address_count" string="Phones and emails" />
                <field name="message_count" string="Messages" />
                <field
                    name="open_incident_count"
                    string="Open incidents"
                    decoration-danger="open_incident_count"
                    decoration-muted="not open_incident_count"
                />
            </tree>
        </field>
    </record>

    <record id="mail_message_import_sender_view_form" model="ir.ui.view">
        <field name="name">mail.message.import.sender.form</field>
        <field name="model">mail.message.import.sender</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_messages"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-comments"
                        >
                            <field
                                name="message_count"
                                widget="statinfo"
                                string="Messages"
                            />
                        </button>
                        <button
                            name="action_view_conversations"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-commenting-o"
                        >
                            <field
                                name="conversation_count"
                                widget="statinfo"
                                string="Conversations"
                            />
                        </button>
                        <button
                            name="action_view_incidents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exclamation-triangle"
                        >
                            <field
                                name="open_incident_count"
                                widget="statinfo"
                                string="Incidents"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. My company" />
                        </h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        The messages sent from the phones and email addresses of the
                        list are assigned to this sender. A message of any other
                        address waits in <strong
                        >To review &gt; Unknown senders</strong>.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="company_id" invisible="1" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Phones and email addresses" name="addresses">
                            <field name="address_ids" context="{'active_test': False}">
                                <tree editable="bottom">
                                    <field name="channel_type" required="1" />
                                    <field name="address" />
                                    <field name="name" />
                                    <field name="address_normalized" optional="hide" />
                                    <field name="authorized_date" optional="hide" />
                                    <field
                                        name="active"
                                        widget="boolean_toggle"
                                        string="Allowed"
                                    />
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="mail_message_import_sender_view_search" model="ir.ui.view">
        <field name="name">mail.message.import.sender.search</field>
        <field name="model">mail.message.import.sender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field
                    name="address_ids"
                    string="Address"
                    filter_domain="['|', ('address_ids.address', 'ilike', self), ('address_ids.address_normalized', 'ilike', self)]"
                />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <filter
                    name="group_company"
                    string="Company"
                    context="{'group_by': 'company_id'}"
                />
            </search>
        </field>
    </record>

    <record id="action_mail_message_import_sender" model="ir.actions.act_window">
        <field name="name">Senders</field>
        <field name="res_model">mail.message.import.sender</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a sender</p>
            <p>
                A sender sends messages from its authorized addresses, its phones or
                its email addresses; usually it is the company itself or one of its
                partners.
            </p>
        </field>
    </record>

    <!-- Authorized addresses -->
    <record id="mail_message_import_address_view_list" model="ir.ui.view">
        <field name="name">mail.message.import.address.list</field>
        <field name="model">mail.message.import.address</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sender_id" />
                <field name="name" />
                <field name="channel_type" required="1" />
                <field name="address" />
                <field name="address_normalized" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="authorized_date" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="mail_message_import_address_view_search" model="ir.ui.view">
        <field name="name">mail.message.import.address.search</field>
        <field name="model">mail.message.import.address</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="address"
                    filter_domain="['|', ('address', 'ilike', self), ('address_normalized', 'ilike', self)]"
                />
                <field name="sender_id" />
                <field name="name" />
                <filter
                    name="archived"
                    string="Revoked"
                    domain="[('active', '=', False)]"
                />
                <filter
                    name="group_sender"
                    string="Sender"
                    context="{'group_by': 'sender_id'}"
                />
                <filter
                    name="group_channel_type"
                    string="Channel"
                    context="{'group_by': 'channel_type'}"
                />
            </search>
        </field>
    </record>

    <record id="action_mail_message_import_address" model="ir.actions.act_window">
        <field name="name">Authorized addresses</field>
        <field name="res_model">mail.message.import.address</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No authorized address yet</p>
            <p>
                The phones and email addresses allowed to send messages on behalf of
                each sender.
            </p>
        </field>
    </record>
</odoo>
