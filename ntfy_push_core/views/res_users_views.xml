<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_users_form_ntfy_unified" model="ir.ui.view">
        <field name="name">res.users.form.ntfy</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notification_type']" position="after">
                <label for="ntfy_topic_url" invisible="notification_type != 'ntfy'" />
                <div class="d-flex" invisible="notification_type != 'ntfy'">
                    <field
                        name="ntfy_topic_url"
                        widget="url"
                        readonly="1"
                        class="oe_inline"
                    />
                    <button
                        name="action_generate_ntfy_url"
                        type="object"
                        class="btn btn-link o_row_helper"
                        icon="fa-refresh"
                        title="Regenerate Subscription URL"
                        confirm="Regenerating will break your existing mobile subscription. Continue?"
                    />
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_ntfy_unified" model="ir.ui.view">
        <field name="name">res.users.simple.form.ntfy</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notification_type']" position="after">
                <label for="ntfy_topic_url" invisible="notification_type != 'ntfy'" />
                <div class="d-flex" invisible="notification_type != 'ntfy'">
                    <field
                        name="ntfy_topic_url"
                        widget="url"
                        readonly="1"
                        class="oe_inline"
                    />
                    <button
                        name="action_generate_ntfy_url"
                        type="object"
                        class="btn btn-link"
                        icon="fa-refresh"
                        title="Regenerate Subscription URL"
                        confirm="Are you sure you want to change your topic ID?"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
