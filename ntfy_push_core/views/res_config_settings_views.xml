<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ntfy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ntfy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="after">
                <block title="ntfy.sh Push Notifications" name="ntfy_config_block">
                    <setting help="Global server URL for push notifications.">
                        <div class="content-group">
                            <label for="ntfy_server_url" string="ntfy Server URL" />
                            <field
                                name="ntfy_server_url"
                                placeholder="https://ntfy.sh"
                            />
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
