<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mail_reply_config_search" model="ir.ui.view">
        <field name="name">mail.reply.config.search</field>
        <field name="model">mail.reply.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id" />
                <group>
                    <filter
                        string="Model"
                        name='model'
                        context="{'group_by':'model_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_mail_reply_config_tree" model="ir.ui.view">
        <field name="name">mail.reply.config.tree</field>
        <field name="model">mail.reply.config</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle" />
                <field name="model_id" />
                <field name="parent_field_id" />
                <field name="parent_model_name" column_invisible="1" />
                <field
                    name="parent_stage_field_id"
                    required="parent_field_id != False"
                    readonly="parent_field_id == False"
                />
                <field name="domain" />
                <field name="reply_stage_field_id" />
                <field
                    name="reply_stage_xml_id"
                    domain="reply_stage_xml_id_domain"
                    required="1"
                    options="{'no_create_edit': True, 'no_quick_create': True}"
                    context="{'mail_reply_stage_model': reply_stage_model_name}"
                />
                <field name="reply_stage_model_name" column_invisible="1" />
                <field name="reply_stage_xml_id_domain" column_invisible="1" />
            </list>
        </field>
    </record>
    <record id="action_mail_reply_config" model="ir.actions.act_window">
        <field name="name">Mail Reply Configurations</field>
        <field name="res_model">mail.reply.config</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mail_reply_config_tree" />
    </record>
    <menuitem
        id="menu_mail_reply_config"
        name="Mail Reply Configurations"
        parent="base.menu_email"
        action="action_mail_reply_config"
        sequence="100"
    />
</odoo>
