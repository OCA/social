<odoo>
    <record id="social_post_view_calendar" model="ir.ui.view">
        <field name="name">social.post.view.calendar</field>
        <field name="model">social.post</field>
        <field name="arch" type="xml">
            <calendar
                js_class="social_calendar"
                string="Social Posts"
                mode="month"
                hide_time="True"
                date_start="date_calendar"
                color="color"
                event_open_popup="true"
                create="1"
                quick_create="0"
                delete="0"
            >
                <field name="account_ids" widget="many2many_tags" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-info="state in ('planned','publishing')"
                    decoration-warning="state == 'partially_published'"
                    decoration-success="state == 'published'"
                    decoration-danger="state == 'cancelled'"
                />
                <field name="send_post_date" invisible="not send_post_date" />
                <field
                    name="image_ids"
                    widget="many2many_tags"
                    invisible="not image_ids"
                />
                <field
                    name="video_ids"
                    widget="many2many_tags"
                    invisible="not video_ids"
                />
                <field
                    name="published_date"
                    invisible="not published_date"
                    widget="datetime"
                />
            </calendar>
        </field>
    </record>

    <record model="ir.actions.act_window.view" id="social_post_action_kanban">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="social_media_base.social_post_view_kanban" />
        <field name="act_window_id" ref="social_media_base.social_post_action" />
    </record>

    <record model="ir.actions.act_window.view" id="social_post_action_calendar">
        <field name="sequence">2</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="social_post_view_calendar" />
        <field name="act_window_id" ref="social_media_base.social_post_action" />
    </record>

</odoo>
