<odoo>

    <record id="social_advertising_campaign_rule_user" model="ir.rule">
        <field
            name="name"
        >Social media campaigns: only the ones the user is responsible for</field>
        <field ref="model_social_advertising_campaign" name="model_id" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[(4, ref('social_media_base.group_social_media_user'))]"
        />
    </record>

    <record id="social_advertising_campaign_rule_manager" model="ir.rule">
        <field name="name">Social media campaigns: all</field>
        <field ref="model_social_advertising_campaign" name="model_id" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('social_media_base.group_social_media_manager'))]"
        />
    </record>

</odoo>
