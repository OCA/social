<odoo>

    <!-- Both menus below are only containers: every list they hold belongs to
         a single social media, so each connector module contributes its own
         submenu with actions filtered on its media. While no connector is
         installed they have no child with an action and Odoo hides them. -->
    <menuitem
        name="Advertising"
        id="social_advertising_menu"
        parent="social_media_base.social_root_menu"
        sequence="5"
        groups="social_media_base.group_social_media_user"
    />

    <menuitem
        name="Stages"
        id="social_stage_root_menu"
        parent="social_media_base.social_configuration_menu"
        sequence="8"
        groups="social_media_base.group_social_media_manager"
    />

</odoo>
