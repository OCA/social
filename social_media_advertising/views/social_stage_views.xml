<odoo>

    <record id="social_stage_view_tree" model="ir.ui.view">
        <field name="name">social.stage.tree</field>
        <field name="model">social.stage</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="media_id" />
                <field name="applies_to" />
                <field name="name" />
                <field name="code" />
                <field name="level" />
                <field name="fold" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="social_stage_view_form" model="ir.ui.view">
        <field name="name">social.stage.form</field>
        <field name="model">social.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Active" />
                        </h1>
                    </div>
                    <group>
                        <group name="scope" string="Scope">
                            <field name="media_id" />
                            <field name="applies_to" />
                            <field name="code" placeholder="e.g. ACTIVE" />
                        </group>
                        <group name="display" string="Display">
                            <field name="sequence" />
                            <field name="level" />
                            <field name="fold" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="social_stage_view_search" model="ir.ui.view">
        <field name="name">social.stage.search</field>
        <field name="model">social.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="media_id" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_media_id"
                        string="Media"
                        context="{'group_by': 'media_id'}"
                    />
                    <filter
                        name="group_applies_to"
                        string="Applies To"
                        context="{'group_by': 'applies_to'}"
                    />
                </group>
            </search>
        </field>
    </record>

</odoo>
