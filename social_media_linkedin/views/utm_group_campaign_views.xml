<odoo>

    <record model="ir.ui.view" id="utm_group_campaign_tree_view">
        <field name="name">utm.group.campaign.tree.social.media.linkedin</field>
        <field name="model">utm.group.campaign</field>
        <field name="inherit_id" ref="social_media_base.utm_group_campaign_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="total_budget" required="1" />
                <field name="currency_id" required="1" />
            </xpath>
        </field>
    </record>

</odoo>
