<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="mail_whatsapp_chatter.WhatsAppIcon">
        <i class="fa fa-whatsapp text-success" title="WhatsApp"/>
    </t>

    <t t-name="mail_whatsapp_chatter.ComposerWhatsAppButton" owl="1">
        <t t-if="whatsappButton">
            <button class="btn btn-sm o_whatsapp_button" t-on-click="sendWhatsappMessage">
                <t t-call="mail_whatsapp_chatter.WhatsAppIcon"/>
            </button>
        </t>
    </t>

    <t t-name="mail.Message.whatsapp" t-inherit="mail.Message" owl="1">
        <xpath expr="//div[@class='o_Message']" position="attributes">
            <attribute name="class">o_Message o_whatsapp</attribute>
        </xpath>
    </t>
</templates>
