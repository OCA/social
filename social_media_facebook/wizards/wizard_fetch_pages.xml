<odoo>

    <record id="wizard_fetch_pages_view_form" model="ir.ui.view">
        <field name="name">wizard.fetch.pages.form</field>
        <field name="model">wizard.fetch.pages</field>
        <field name="arch" type="xml">
            <form string="Fetch Facebook Pages">
                <group>
                    <field name="user_access_token" invisible="1" />
                    <field name="page_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="selected" />
                            <field name="page_name" readonly="1" />
                            <field name="page_id" readonly="1" />
                            <field name="already_connected" readonly="1" />
                            <field name="page_access_token" invisible="1" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="action_create_accounts"
                        string="Connect Selected Pages"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
