<odoo noupdate="1">
    <!--
    NOTE: Facebook auto-sync is handled by the base module's cron:
    - social_media_base.webhook_schedule_job runs every 30 minutes
    - Calls _run_check_media_updates() which is overridden in this module

    Manual sync options:
    - Quick Sync button on account form (action_sync_facebook_content)
    - Sync from Date wizard (wizard.facebook.sync) for historical imports
    -->
    <record id="ir_cron_update_facebook_insights" model="ir.cron">
        <field name="name">Update Facebook Insights</field>
        <field name="model_id" ref="social_media_base.model_social_account" />
        <field name="state">code</field>
        <field name="code">model.cron_update_facebook_insights()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="priority">1</field>
        <field name="active" eval="True" />
    </record>
</odoo>
