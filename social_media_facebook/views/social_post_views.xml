<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Search view with filters - Feature #2.1 -->
  <record id="social_post_search_view_facebook" model="ir.ui.view">
    <field name="name">social.post.search.facebook</field>
    <field name="model">social.post</field>
    <field name="inherit_id" ref="social_media_base.social_post_view_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <!-- Content Type Filters -->
        <filter name="filter_fb_posts" string="Posts" domain="[('fb_content_type', '=', 'post')]"/>
        <filter name="filter_fb_reels" string="Reels" domain="[('fb_content_type', '=', 'reel')]"/>
        <filter name="filter_fb_ads" string="Ads" domain="[('fb_content_type', '=', 'ad')]"/>
        <separator/>
        <!-- Date Filters -->
        <filter name="filter_last_7_days" string="Last 7 Days"
                domain="[('created_time', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
        <filter name="filter_last_30_days" string="Last 30 Days"
                domain="[('created_time', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
        <separator/>
        <!-- Search Fields -->
        <field name="fb_content_id"/>
        <field name="fb_content_type"/>
        <field name="permalink_url"/>
        <separator/>
        <!-- Group By -->
        <group expand="0" string="Group By">
          <filter name="group_by_content_type" string="Content Type" context="{'group_by': 'fb_content_type'}"/>
          <filter name="group_by_created_date" string="Created Date" context="{'group_by': 'created_time:month'}"/>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
