<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- Add click handler to open account form -->
    <t
        t-name="social_media_facebook.SocialAccountExtended"
        t-inherit="social_media_base.SocialAccount"
        t-inherit-mode="extension"
    >
        <!-- Add click handler to card div to open account form -->
        <xpath expr="//div[hasclass('cursor-pointer')]" position="attributes">
            <attribute
                name="t-on-click"
            >() => this.onCardClick(social_account)</attribute>
        </xpath>
    </t>

</templates>
