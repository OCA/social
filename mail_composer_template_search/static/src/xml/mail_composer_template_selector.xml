<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="mail.MailComposerTemplateSelector" t-inherit-mode="extension">
        <!-- Add search input below the "Insert Template" header -->
        <xpath expr="//div[hasclass('px-3', 'pb-1', 'text-muted')][1]" position="after">
            <div class="px-2 pb-2 mail-template-search-container">
                <input
                    type="text"
                    class="form-control form-control-sm mail-template-search-input"
                    placeholder="Search templates..."
                    t-on-input="onSearchInput"
                    t-on-keydown="onSearchKeydown"
                />
            </div>
        </xpath>

        <!-- Replace the template list to use displayedTemplates -->
        <xpath
            expr="//t[@t-foreach='state.templates'][@t-as='template'][1]"
            position="replace"
        >
            <t t-foreach="displayedTemplates" t-as="template" t-key="template_index">
                <DropdownItem
                    class="'text-truncate'"
                    onSelected="() => this.onLoadTemplate(template)"
                >
                    <t t-if="template.display_name" t-out="template.display_name" />
                    <span t-else="" class="fst-italic">Untitled</span>
                </DropdownItem>
            </t>
        </xpath>

        <!-- Replace "No saved templates" to also handle search case -->
        <xpath expr="//div[@t-if='state.templates.length === 0'][1]" position="replace">
            <div t-if="state.isSearching" class="fst-italic px-3 text-muted">
                Searching...
            </div>
            <div
                t-elif="state.searchQuery and displayedTemplates.length === 0"
                class="fst-italic px-3 text-muted"
            >
                No matching templates
            </div>
            <div
                t-elif="!state.searchQuery and (state.templates || []).length === 0"
                class="fst-italic px-3"
            >
                No saved templates
            </div>
        </xpath>

        <!-- Update Search More visibility to use showSearchMore -->
        <xpath
            expr="//DropdownItem[contains(@onSelected, 'onSelectTemplateSearchMoreBtnClick')]"
            position="attributes"
        >
            <attribute name="t-if">showSearchMore</attribute>
        </xpath>
    </t>

</templates>
