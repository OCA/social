<odoo>
    <!-- Category for social media groups (UI grouping) -->
    <record model="ir.module.category" id="module_category_social_media">
        <field name="name">Social Media</field>
        <field name="sequence">17</field>
    </record>

    <!-- Privilege for social media groups -->
    <record id="privilege_social_media" model="res.groups.privilege">
        <field name="name">Social Media</field>
        <field name="category_id" ref="base.module_category_human_resources" />
    </record>

    <!-- Social Media User Group -->
    <record id="group_social_media_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_social_media" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!-- Social Media Manager Group -->
    <record id="group_social_media_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_social_media" />
        <field name="implied_ids" eval="[(4, ref('group_social_media_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
