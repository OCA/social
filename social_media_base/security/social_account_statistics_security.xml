<odoo>

    <record id="social_account_statistics_rule_user" model="ir.rule">
        <field
            name="name"
        >Social media account statistics: only the ones of the accounts the user is responsible for</field>
        <field ref="model_social_account_statistics" name="model_id" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[(4, ref('social_media_base.group_social_media_user'))]"
        />
    </record>

    <record id="social_account_statistics_rule_manager" model="ir.rule">
        <field name="name">Social media account statistics: all</field>
        <field ref="model_social_account_statistics" name="model_id" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('social_media_base.group_social_media_manager'))]"
        />
    </record>

    <record id="social_account_statistics_rule_company" model="ir.rule">
        <field name="name">Social media account statistics: multi-company</field>
        <field ref="model_social_account_statistics" name="model_id" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
