<odoo>
    <record id="wizard_social_account_view_form" model="ir.ui.view">
        <field name="name">Associate Social Account</field>
        <field name="model">wizard.social.account</field>
        <field name="arch" type="xml">
            <form>
                <field
                    name="image"
                    widget="image"
                    class="oe_avatar"
                    invisible="context.get('social_update_account', False)"
                />
                <div class="oe_title mb24">
                    <h1>
                        <field
                            name="media_id"
                            invisible="context.get('social_update_account', False)"
                            readonly="1"
                            options="{'no_open': True}"
                        />

                        <field
                            name="account_id"
                            readonly="1"
                            options="{'no_open': True}"
                            invisible="not context.get('social_update_account', False)"
                        />
                    </h1>
                </div>
                <group name="social_account_action">
                    <field
                        name="update_keys"
                        widget="boolean_toggle"
                        invisible="not context.get('social_update_account', False)"
                    />
                    <field
                        name="update_token"
                        widget="boolean_toggle"
                        invisible="not context.get('social_update_account', False)"
                    />
                </group>
                <group name="social_account_data" />
                <footer>
                    <button
                        name="action_associate_social_account"
                        string="Associate"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="context.get('social_update_account', False)"
                    />
                    <button
                        name="update_account"
                        string="Update"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="not context.get('social_update_account', False)"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
