<odoo>

    <record model="ir.actions.act_window" id="utm_campaign_social_action">
        <field name="name">Campaigns</field>
        <field name="res_model">utm.campaign</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{"from_social_media": True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first campaign
            </p>
            <p>
                Campaigns hold the budget and bidding settings used to promote
                your posts on social media.
            </p>
        </field>
    </record>

    <record model="ir.ui.view" id="utm_campaign_social_view_tree">
        <field name="name">utm.campaign.tree.social.media</field>
        <field name="model">utm.campaign</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="allow_media_ids" column_invisible="1" />
                <field name="title" string="Name" readonly="1" />
                <field name="name" column_invisible="1" />
                <field name="campaign_group_id" />
                <field name="media_id" />
                <field name="account_id" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="stage_id" decoration-bf="1" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
            </tree>
        </field>
    </record>

    <record
        model="ir.actions.act_window.view"
        id="utm_campaign_social_action_view_tree"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="utm_campaign_social_view_tree" />
        <field name="act_window_id" ref="utm_campaign_social_action" />
    </record>

    <record model="ir.ui.view" id="utm_campaign_view_form">
        <field name="name">utm.campaign.view.form.inherit.social.media.base</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    name="social_media"
                    string="Social Media"
                    invisible="not context.get('from_social_media', False) and not media_id"
                >
                    <group name="social_media_campaign">
                        <group name="social_media_general" string="General">
                            <field name="allow_media_ids" invisible="1" />
                            <field
                                name="media_id"
                                options="{'no_create_edit': True, 'no_create': True}"
                            />
                            <field
                                name="campaign_group_id"
                                required="media_id != False"
                                options="{'no_quick_create': True}"
                            />
                            <field
                                name="account_id"
                                required="media_id != False"
                                options="{'no_create_edit': True, 'no_create': True}"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute
                    name="invisible"
                >context.get('from_social_media', False)</attribute>
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </xpath>
        </field>
    </record>

</odoo>
