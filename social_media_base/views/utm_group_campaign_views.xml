<odoo>

    <record model="ir.ui.view" id="utm_group_campaign_tree_view">
        <field name="name">utm.group.campaign.tree</field>
        <field name="model">utm.group.campaign</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="utm_group_campaign_act_window_tree">
        <field name="name">Campaign group</field>
        <field name="res_model">utm.group.campaign</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
