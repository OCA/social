<odoo>
    <record model="ir.ui.view" id="social_media_kanban_view">
        <field name="name">social.media.kanban</field>
        <field name="model">social.media</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" js_class="social_kanban">
                <field name="name" />
                <field name="description" />
                <field name="image" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card d-flex flex-column p-3">
                            <!-- Top section: Icon + Content in 2 columns -->
                            <div class="d-flex align-items-start mb-3">
                                <!-- Icon column -->
                                <div class="flex-shrink-0 me-3">
                                    <img
                                        t-att-src="record.image.value ? '/web/image/social.media/' + record.id.raw_value + '/image' : '/social_media_base/static/description/icon.png'"
                                        class="rounded"
                                        style="width: 80px; height: 80px; object-fit: contain;"
                                        t-att-alt="record.name.raw_value"
                                    />
                                </div>

                                <!-- Content column -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <h5
                                        class="mb-1 fw-bold"
                                        t-esc="record.name.raw_value"
                                    />
                                    <p
                                        class="text-muted mb-0 small"
                                        t-esc="record.description.raw_value"
                                    />
                                </div>
                            </div>

                            <!-- Bottom section: Full-width button -->
                            <button
                                type="object"
                                class="btn btn-primary w-100 mt-auto"
                                name="open_action_account"
                            >Link account
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.actions.act_window" id="social_media_act_window_kanban">
        <field name="name">Social Media</field>
        <field name="res_model">social.media</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
