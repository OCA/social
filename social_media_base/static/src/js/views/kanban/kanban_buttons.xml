<templates xml:space="preserve">

    <t
        t-name="social_media_base.KanbanView.Buttons"
        t-inherit="web.KanbanView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="//div[hasclass('o_cp_buttons')]" position="inside">
            <button
                type="button"
                class="btn btn-primary o__kanban_new_account me-1"
                t-on-click.prevent="_onAddAccount"
                t-if="!isAccountPanelHidden"
                title="Authorize Odoo on a social media and link one of its accounts."
            >
                Add account
            </button>
            <button
                type="button"
                class="btn btn-primary o_kanban_new_post me-1"
                t-on-click.prevent="_onAddPost"
                t-if="!isAccountPanelHidden"
                title="Write a new post and choose the accounts it goes to."
            >
                Add Post
            </button>
            <button
                type="button"
                class="btn btn-primary o_kanban_statistics_refresh_now"
                t-on-click.prevent="_onUpdatePostsAndStatistics"
                t-if="!isAccountPanelHidden"
                title="Ask the social media again for the publications and the figures of these accounts, instead of waiting for the next automatic pass."
            >
                <span>
                <i
                        t-if="!socialState.syncPosts"
                        class="fa fa-refresh px-1"
                        aria-hidden="true"
                    />
                    <span class="social-loader" t-if="socialState.syncPosts" />
                    Update
                </span>
            </button>
        </xpath>
    </t>

</templates>
