<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="social_media_base.SocialChart">
        <div t-if="socialAccountStatistics.length > 0" class="social-chart px-2 mt-2">
            <SocialChartAccount
                t-foreach="socialAccountStatistics"
                t-as="chartAccount"
                t-key="chartAccount.id"
                socialChartAccount="chartAccount"
            />
        </div>
        <div t-elif="social_state.loaderChart" class="text-center text-muted py-5 px-3">
            <span class="social-loader" />
            <h4 class="text-muted mt-3">Loading statistics...</h4>
        </div>
        <div t-else="">
            <div class="o_empty_state text-center py-5 px-3 bg-light rounded">
                <img
                    src="/web/static/img/smiling_face.svg"
                    class="img-fluid mb-3"
                    style="max-width: 300px;"
                    alt="No data"
                />
                <h4 class="text-muted">No data to display</h4>
                <p
                    class="text-muted"
                >Once you have recorded information, you can view it here as a graph.</p>
            </div>
        </div>
    </t>
</templates>
