<templates xml:space="preserve">

    <t t-name="social_media_base.SocialMessage">
        <div class="o_social_message_block">
            <div
                t-ref="text"
                t-attf-class="o_social_message {{ props.className }} {{ state.expanded ? expandedClass : '' }}"
                t-attf-style="--o-social-message-lines: {{ props.lines }}"
                t-esc="props.text"
            />
            <span
                t-if="state.overflowing"
                class="cursor-pointer show-more-message"
                t-on-click.stop="onToggle"
                t-esc="toggleLabel"
            />
        </div>
    </t>

</templates>
