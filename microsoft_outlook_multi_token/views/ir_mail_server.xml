<data>
    <record id="ir_mail_server_view_form" model="ir.ui.view">
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="microsoft_outlook.ir_mail_server_view_form" />
        <field name="arch" type="xml">
            <field name="smtp_pass" position="after">
                <field
                    name="microsoft_outlook_client_id"
                    placeholder="Server-specific client id"
                    attrs="{'invisible': [('use_microsoft_outlook_service', '=', False)]}"
                />
                <field
                    name="microsoft_outlook_client_secret"
                    placeholder="Server-specific client secret"
                    attrs="{'invisible': [('use_microsoft_outlook_service', '=', False)]}"
                />
            </field>
        </field>
    </record>
</data>
