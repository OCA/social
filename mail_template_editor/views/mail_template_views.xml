<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="email_template_form">
        <field name="name">email.template.form</field>
        <field name="model">mail.template</field>
        <field name="inherit_id" ref="mail.email_template_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    string="Edit Design"
                    name="create_mailing_mailing"
                    type="object"
                    groups="mail.group_mail_template_editor"
                />
                <button
                    string="Apply Mailing Design"
                    name="apply_mailing_html"
                    type="object"
                    groups="mail.group_mail_template_editor"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_mailings"
                    type="object"
                    class="oe_stat_button"
                    attrs="{'invisible': [('mailing_count', '=', 0)]}"
                    icon="fa-envelope"
                >
                    <field name="mailing_count" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
