<odoo>
    <record id="mail_message_import_channel_view_list" model="ir.ui.view">
        <field name="name">mail.message.import.channel.list.email</field>
        <field name="model">mail.message.import.channel</field>
        <field
            name="inherit_id"
            ref="mail_message_import.mail_message_import_channel_view_list"
        />
        <field name="arch" type="xml">
            <field name="channel_type" position="after">
                <field name="email_address" optional="show" />
            </field>
        </field>
    </record>

    <record id="mail_message_import_channel_view_form" model="ir.ui.view">
        <field name="name">mail.message.import.channel.form.email</field>
        <field name="model">mail.message.import.channel</field>
        <field
            name="inherit_id"
            ref="mail_message_import.mail_message_import_channel_view_form"
        />
        <field name="arch" type="xml">
            <group name="channel" position="inside">
                <field
                    name="email_address"
                    invisible="channel_type != 'email'"
                    required="channel_type == 'email'"
                    placeholder="e.g. orders@company.com"
                />
                <!-- A new server comes set up for the channel, see default_get. -->
                <field
                    name="fetchmail_server_id"
                    invisible="channel_type != 'email'"
                    groups="base.group_system"
                    options="{'no_quick_create': True}"
                    context="{'mail_message_import_mail_server': True, 'default_name': name, 'default_user': email_address}"
                />
                <button
                    name="action_open_mail_server"
                    type="object"
                    string="Configure the incoming mail server"
                    class="btn-link"
                    icon="fa-arrow-right"
                    groups="base.group_system"
                    invisible="channel_type != 'email'"
                    colspan="2"
                />
            </group>
        </field>
    </record>

    <record id="mail_message_import_channel_view_kanban" model="ir.ui.view">
        <field name="name">mail.message.import.channel.kanban.email</field>
        <field name="model">mail.message.import.channel</field>
        <field
            name="inherit_id"
            ref="mail_message_import.mail_message_import_channel_view_kanban"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@name='channel_info']/field[@name='channel_type']"
                position="attributes"
            >
                <attribute name="decoration-info">channel_type == 'email'</attribute>
            </xpath>
            <div name="channel_info" position="inside">
                <field name="email_address" class="ms-2" />
            </div>
        </field>
    </record>

    <record id="mail_message_import_channel_view_search" model="ir.ui.view">
        <field name="name">mail.message.import.channel.search.email</field>
        <field name="model">mail.message.import.channel</field>
        <field
            name="inherit_id"
            ref="mail_message_import.mail_message_import_channel_view_search"
        />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="email_address" />
            </field>
            <filter name="archived" position="before">
                <filter
                    name="email"
                    string="Email"
                    domain="[('channel_type', '=', 'email')]"
                />
                <separator />
            </filter>
        </field>
    </record>
</odoo>
