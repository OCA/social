#. module: mail_gateway_instagram
#: model_terms:ir.ui.view,arch_db:mail_gateway_instagram.mail_gateway_form_view
msgid ""
"Copy the access token into <b>Token</b>, the Meta\n"
"                                app secret into <b>Webhook Secret</b>, a verify\n"
"                                token of your choice into <b>Instagram Security Key</b>,\n"
"                                and the professional account IGID into <b>Instagram Account</b>."
msgstr ""
"Copia il token di accesso in <b>Token</b>, \n"
"                                il segreto dell'app Meta in <b>Webhook "
"Secret</b>, \n"
"                                un token di verifica a tua scelta in <b>"
"Instagram Security Key</b> \n"
"                                e l'IGID dell'account professionale in <b>"
"Instagram Account</b>."

