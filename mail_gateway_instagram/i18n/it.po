#. module: mail_gateway_instagram
#: model_terms:ir.ui.view,arch_db:mail_gateway_instagram.mail_gateway_form_view
msgid ""
"Open this tab, copy <b>Webhook URL</b> into the\n"
"                                Meta app callback URL. Use <b>Instagram Security\n"
"                                Key</b> as the verify token. Subscribe the\n"
"                                <b>messages</b> field only. Meta calls GET\n"
"                                verification and the state becomes Integrated."
msgstr ""
"Apri questa scheda e copia l'<b>URL del webhook</b> \n"
"                                nell'URL di callback dell'app Meta. \n"
"                                Usa la <b>chiave di sicurezza di Instagram</"
"b> \n"
"                                come token di verifica. Sottoscrivi solo il "
"campo <b>messages</b>. \n"
"                                Meta effettua la verifica GET e lo stato "
"passa a \"Integrato\"."

#. module: mail_gateway_instagram
#: model_terms:ir.ui.view,arch_db:mail_gateway_instagram.mail_gateway_form_view
msgid ""
"Set <b>Webhook Key</b> and <b>Webhook User</b>,\n"
"                                save, then press <b>Integrate Webhook</b>."
msgstr ""
"Imposta <b>Chiave webhook</b> e <b>Utente webhook</b>,\n"
"                                salva, quindi premi <b>Integra webhook</b>."

