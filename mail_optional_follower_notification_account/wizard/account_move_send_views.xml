<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_move_send_form" model="ir.ui.view">
        <field name="model">account.move.send</field>
        <field name="inherit_id" ref="account.account_move_send_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='mail_partner_ids']" position="before">
                <field name="notify_followers" invisible="mode == 'invoice_multi'" />
            </xpath>
            <field name="mail_partner_ids" position="after">
                <span
                    name="no_followers_text"
                    invisible="notify_followers"
                    style="color: red;"
                >Warning : Followers will not be notified but they can access the notification directly from the document (if they are allowed to)</span>
            </field>
        </field>
    </record>

</odoo>
