<data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="emails" position="inside">
            <div class="col-12 col-lg-6 o_setting_box" id="mail_routing_subject">
                <div class="o_setting_left_pane" />
                <div class="o_setting_right_pane">
                    <field name="mail_routing_subject_prefixes" />
                    <div class="text-muted">
                        Fill in all subject prefixes Odoo should recognize as reply, separate them with a space and include the colon.
                    </div>
                </div>
            </div>
            </div>
        </field>
    </record>
</data>
