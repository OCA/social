#: model_terms:ir.ui.view,arch_db:social_media_x.wizard_social_account_view_form_inherit
msgid "X API pricing"
msgstr "Tariffe dell'API di X"

#. module: social_media_x
#: model:ir.model.fields,field_description:social_media_x.field_social_account__x_access_secret_oauth1
msgid "X Access Secret Oauth1"
msgstr "Segreto di accesso X OAuth1"

#. module: social_media_x
#: model:ir.model.fields,field_description:social_media_x.field_social_account__x_credit_warned
msgid "X Credit Warned"
msgstr "Avviso credito X inviato"

#. module: social_media_x
#: model:ir.model.fields,field_description:social_media_x.field_social_account__x_premium
msgid "X Premium"
msgstr "X Premium"

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post_account.py:0
msgid ""
"X did not accept the post. The account may have reached the limit of "
"requests of its plan: check the account and try again later."
msgstr ""
"X non ha accettato il post. L'account potrebbe aver raggiunto il limite di "
"richieste previsto dal suo piano: controlla l'account e riprova più tardi."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X only publishes JPG, PNG, WEBP and GIF images, so %(names)s cannot be "
"published. Convert them or remove them from the post."
msgstr ""
"X pubblica solo immagini JPG, PNG, WEBP e GIF; pertanto, non è possibile "
"pubblicare %(names)s. Convertile o rimuovile dal post."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X only publishes MP4 videos, so %(names)s cannot be published. Convert them "
"to MP4 or remove them from the post."
msgstr ""
"X pubblica solo video MP4; pertanto, non è possibile pubblicare %(names)s. "
"Converti i video in MP4 o rimuovili dal post."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X publishes a single video per post, so this post carrying %(videos)s videos"
" cannot be published. Leave one video or create a separate post for each of "
"them."
msgstr ""
"X consente di pubblicare un solo video per post; pertanto, non è possibile "
"pubblicare questo post che contiene %(videos)s video. Lascia un solo video o "
"crea un post separato per ciascuno di essi."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X publishes at most %(limit)s characters per post, and this one has "
"%(length)s. Shorten the message to publish it."
msgstr ""
"X consente di pubblicare al massimo %(limit)s caratteri per post, mentre "
"questo ne contiene %(length)s. Riduci la lunghezza del messaggio per "
"pubblicarlo."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X publishes at most %(limit)s images per post, and this one carries "
"%(images)s. Remove some of them or create a separate post."
msgstr ""
"X consente di pubblicare al massimo %(limit)s immagini per post, mentre "
"questo ne contiene %(images)s. Rimuovine alcune o crea un post separato."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X publishes either images or a video, not both in the same post. Leave one "
"kind of media or create a separate post for each of them."
msgstr ""
"X consente di pubblicare immagini oppure un video, ma non entrambi nello "
"stesso post. Mantieni un solo tipo di contenuto multimediale o crea un post "
"separato per ciascuno."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X publishes images of at most %(limit)s, %(gif_limit)s for a GIF, so "
"%(names)s cannot be published. Reduce their size or remove them from the "
"post."
msgstr ""
"X consente di pubblicare immagini con dimensione massima di %(limit)s ( %"
"(gif_limit)s per le GIF); pertanto, non è possibile pubblicare %(names)s. "
"Riduci le dimensioni o rimuovile dal post."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_post.py:0
msgid ""
"X publishes videos of at most %(limit)s, so %(names)s cannot be published. "
"Reduce their size or remove them from the post."
msgstr ""
"X consente di pubblicare video con dimensione massima di %(limit)s; "
"pertanto, non è possibile pubblicare %(names)s. Riduci le dimensioni o "
"rimuovili dal post."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_account.py:0
msgid "X refused the post of %(account)s: %(error)s."
msgstr "X ha rifiutato il post dell'account %(account)s: %(error)s."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_account.py:0
msgid ""
"X refused the post of %(account)s: %(error)s. What an account may publish "
"depends on its plan, and X reported X Premium for this account when it was "
"last read. Press Update account to read the plan again before trying again."
msgstr ""
"X ha rifiutato il post dell'account %(account)s: %(error)s. I contenuti che "
"un account può pubblicare dipendono dal suo piano e, all'ultima verifica, X "
"ha indicato che questo account dispone di X Premium. Seleziona Aggiorna "
"account per verificare nuovamente il piano prima di riprovare."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_account.py:0
msgid ""
"X rejected the request because the developer App cannot spend against the "
"API. Connect the App to a Pay Per Use project in Project Access > Manage, "
"not the Default project on Standard Basic, make sure the account has credit "
"in the Developer Console, see %(pricing_link)s, then try again."
msgstr ""
"X ha rifiutato la richiesta perché l'app dello sviluppatore non può "
"effettuare addebiti sull'API. Collega l'app a un progetto Pay Per Use in "
"Project Access > Manage, non al progetto predefinito del piano Standard "
"Basic, assicurati che l'account disponga di credito nella console per "
"sviluppatori, consulta %(pricing_link)s e riprova."

#. module: social_media_x
#. odoo-python
#: code:addons/social_media_x/models/social_account.py:0
msgid ""
"You have reached the limit of requests <b>%(endpoint)s</b> allowed according"
" to your account plan.<br>• <b>Total limit:</b> %(limit)s request(s) per "
"window or period<br>• <b>Remaining:</b> %(remaining)s<br>• <b>Next "
"request:</b> %(next_request)s<br>Please try again after that time (Next "
"request).<br>For more information, see the <a href='%(rate_limit_url)s' "
"target='_blank'>rate limits</a>."
msgstr ""
"Hai raggiunto il limite di richieste <b>%(endpoint)s</b> consentito dal "
"piano del tuo account.<br>• <b>Limite totale:</b> %(limit)s richiesta/e per "
"intervallo o periodo<br>• <b>Rimanenti:</b> %(remaining)s<br>• <b>Prossima "
"richiesta:</b> %(next_request)s<br>Riprova dopo l'orario indicato (Prossima "
"richiesta).<br>Per ulteriori informazioni, consulta i <a href='%"
"(rate_limit_url)s' target='_blank'>limiti di richieste</a>."
