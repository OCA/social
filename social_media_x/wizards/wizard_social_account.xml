<odoo>

    <record id="wizard_social_account_view_form_inherit" model="ir.ui.view">
        <field name="name">wizard.social.account.view.form.inherit.x</field>
        <field name="model">wizard.social.account</field>
        <field
            name="inherit_id"
            ref="social_media_base.wizard_social_account_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_account_data']" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="media_type != 'x'"
                >
                    The X API no longer has a free access tier. The developer
                    App must belong to a Project and be enrolled in a paid
                    plan, otherwise X rejects every request of this module.
                    See the
                    <a
                        href="https://docs.x.com/x-api/getting-started/pricing"
                        target="_blank"
                    >X API pricing</a>.
                </div>
            </xpath>
            <xpath expr="//group[@name='social_account_data']" position="inside">
                <field name="media_type" invisible="1" />
                <field
                    name="x_api_key"
                    required="media_type == 'x' or (update_keys and context.get('social_update_account', False))"
                    invisible="media_type != 'x' or (not update_keys and context.get('social_update_account', False))"
                />
                <field
                    name="x_api_secret"
                    password="True"
                    required="media_type == 'x' or (update_keys and context.get('social_update_account', False))"
                    invisible="media_type != 'x' or (not update_keys and context.get('social_update_account', False))"
                />
            </xpath>
        </field>
    </record>
</odoo>
