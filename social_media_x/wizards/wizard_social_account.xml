<odoo>

    <record id="wizard_social_account_view_form" model="ir.ui.view">
        <field name="name">Associate Social Account</field>
        <field name="model">wizard.social.account</field>
        <field
            name="inherit_id"
            ref="social_media_base.wizard_social_account_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_account_data']" position="inside">
                <field name="media_type" invisible="True" />
                <field
                    name="x_api_key"
                    required="media_type == 'x' or (update_keys and context.get('social_update_account', False))"
                    invisible="media_type != 'x' or (not update_keys and context.get('social_update_account', False))"
                />
                <field
                    name="x_api_secret"
                    password="True"
                    required="media_type == 'x' or (update_keys and context.get('social_update_account', False))"
                    invisible="media_type != 'x' or (not update_keys and context.get('social_update_account', False))"
                />
            </xpath>
        </field>
    </record>
</odoo>
