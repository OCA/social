<odoo>

    <record id="social_account_view_form_inherit" model="ir.ui.view">
        <field name="name">social.account.view.form.inherit.x</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social_media_base.social_account_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_configuration']" position="inside">
                <group>
                    <field
                        name="x_premium"
                        widget="boolean_toggle"
                        invisible="media_type != 'x'"
                    />
                    <field
                        name="x_api_key"
                        readonly="1"
                        invisible="media_type != 'x'"
                    />
                    <field
                        name="x_api_secret"
                        password="1"
                        readonly="1"
                        invisible="media_type != 'x'"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
