<odoo>

    <record model="ir.ui.view" id="social_post_account_view_search">
        <field
            name="name"
        >social.post.account.view.search.inherit.social.media.x</field>
        <field name="model">social.post.account</field>
        <field
            name="inherit_id"
            ref="social_media_base.social_post_account_view_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='with_impressions']" position="after">
                <filter
                    string="With Reposts"
                    name="with_reposts"
                    domain="[('retweet_count', '&gt;', 0)]"
                />
                <filter
                    string="With Quotes"
                    name="with_quotes"
                    domain="[('quote_count', '&gt;', 0)]"
                />
            </xpath>
        </field>
    </record>

</odoo>
