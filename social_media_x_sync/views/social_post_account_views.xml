<odoo>

    <!-- Reposts and quotes are figures the import of this module writes, and
         they are searched where they are imported. -->
    <record id="social_post_account_view_search_inherit" model="ir.ui.view">
        <field
            name="name"
        >social.post.account.view.search.inherit.social.media.x.sync</field>
        <field name="model">social.post.account</field>
        <field
            name="inherit_id"
            ref="social_media_base.social_post_account_view_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='with_impressions']" position="after">
                <filter
                    string="With Reposts"
                    name="with_reposts"
                    domain="[('retweet_count', '&gt;', 0)]"
                />
                <filter
                    string="With Quotes"
                    name="with_quotes"
                    domain="[('quote_count', '&gt;', 0)]"
                />
            </xpath>
        </field>
    </record>

    <!-- The list of figures belongs to social_media_sync and the two fields
         to social_media_x, so this bridge, the only module that depends on
         both, is where the columns are added, as the filters above. The list
         is shared by every social media, so they stay hidden until asked for,
         like the shares and the impressions. -->
    <record id="social_post_account_view_tree_inherit" model="ir.ui.view">
        <field
            name="name"
        >social.post.account.view.tree.inherit.social.media.x.sync</field>
        <field name="model">social.post.account</field>
        <field
            name="inherit_id"
            ref="social_media_sync.social_post_account_view_tree_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='share_count']" position="after">
                <field name="retweet_count" string="Reposts" optional="hide" />
                <field name="quote_count" string="Quotes" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
