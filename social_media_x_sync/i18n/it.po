msgstr "Il post non esiste o è stato eliminato."

#. module: social_media_x_sync
#. odoo-python
#: code:addons/social_media_x_sync/models/social_post_account.py:0
#, python-format
msgid ""
"The recommendation could not be sent to X. The account may have reached the "
"limit of requests of its plan."
msgstr ""
"Impossibile inviare la raccomandazione a X. L'account potrebbe aver "
"raggiunto il limite di richieste del suo piano."

#. module: social_media_x_sync
#: model:ir.model.fields,help:social_media_x_sync.field_social_account__post_since_id
msgid "This post is updated with each request with the latest one."
msgstr "Questo post viene aggiornato a ogni richiesta con l'ultimo."

