#. module: social_media_x_sync
#. odoo-python
#: code:addons/social_media_x_sync/models/social_post_account.py:0
#, python-format
msgid ""
"The comment could not be deleted on X. The account may have reached the "
"limit of requests of its plan."
msgstr ""
"Impossibile eliminare il commento su X. L'account potrebbe aver raggiunto il "
"limite di richieste del suo piano."

#. module: social_media_x_sync
#. odoo-python
#: code:addons/social_media_x_sync/models/social_post_account.py:0
#, python-format
msgid ""
"The comment could not be published on X. The account may have reached the "
"limit of requests of its plan."
msgstr ""
"Impossibile pubblicare il commento su X. L'account potrebbe aver raggiunto "
"il limite di richieste del suo piano."

#. module: social_media_x_sync
#. odoo-python
#: code:addons/social_media_x_sync/models/social_post_account.py:0
#, python-format
msgid ""
"The comments could not be read from X. The account may have reached the "
"limit of requests of its plan."
msgstr ""
"Impossibile leggere i commenti da X. L'account potrebbe aver raggiunto il "
"limite di richieste del suo piano."

#. module: social_media_x_sync
#. odoo-python
